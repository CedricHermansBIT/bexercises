# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session Secret (generate a random string)
SESSION_SECRET=your_random_session_secret_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Base Path for subdirectory deployment (leave empty for root deployment)
# Example: BASE_PATH=/bitlab
BASE_PATH=

# Optional exact origin for a separate frontend (same-origin needs no CORS)
CORS_ORIGIN=

# Callback URL (update for production)
CALLBACK_URL=http://localhost:3000/auth/google/callback

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,user@example.com

# Or use domain-based admin access (all emails ending with this domain)
ADMIN_DOMAIN=@bitlab.nl

# Execution admission and sandbox limits
MAX_PARALLEL_TESTS=2
MAX_QUEUED_RUNS=20
RUNS_PER_MINUTE=6
PER_TEST_TIMEOUT_MS=30000
DOCKER_CPUS=1
DOCKER_MEMORY=256m
DOCKER_PIDS_LIMIT=128
DOCKER_DATABASE_MEMORY=1g
DOCKER_DATABASE_STORAGE_SIZE=512m
DOCKER_DATABASE_PIDS_LIMIT=256
DOCKER_WORKSPACE_SIZE=64m
DOCKER_TMP_SIZE=16m
MAX_RUN_OUTPUT_BYTES=65536
MAX_ARCHIVE_BYTES=67108864
MAX_ARCHIVE_EXPANDED_BYTES=67108864
MAX_ARCHIVE_MEMBERS=1000
ARCHIVE_INSPECT_TIMEOUT_MS=10000

# Exam archive limits
MAX_EXAM_ARCHIVE_BYTES=33554432
MAX_EXAM_UNCOMPRESSED_BYTES=33554432
MAX_EXAM_FILES=500
MAX_EXAM_DEPTH=8

